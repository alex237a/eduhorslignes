<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduHorsLigne.ViewModels"
             xmlns:m="clr-namespace:EduHorsLigne.Models"
             xmlns:loc="clr-namespace:EduHorsLigne.Helpers"
             xmlns:c="clr-namespace:EduHorsLigne.Views.Controls"
             xmlns:v="clr-namespace:EduHorsLigne.Views"
             x:Class="EduHorsLigne.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <c:AppBar Title="{Binding [forgot_title], Source={x:Static loc:Loc.Instance}}" ShowBack="True" ShowAvatar="False" />
        <Grid Grid.Row="1">

    <ScrollView>
        <c:CenteredContent>
            <VerticalStackLayout Padding="16" Spacing="16">
                <Label Text="🔑" FontSize="48" HorizontalOptions="Center" />
                <Label Text="{Binding [forgot_title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TitleLabel}" />
                <Label Text="{Binding [forgot_text], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource MutedLabel}" />
                <c:FormField Title="{Binding [field_identifier], Source={x:Static loc:Loc.Instance}}" Placeholder="{Binding [ph_identifier], Source={x:Static loc:Loc.Instance}}"
                             Text="{Binding Identifiant}" InputKeyboard="Email" />
                <Button Text="{Binding [send_code], Source={x:Static loc:Loc.Instance}}" Command="{Binding SendCommand}" />
            </VerticalStackLayout>
        </c:CenteredContent>
    </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
