<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduHorsLigne.ViewModels"
             xmlns:m="clr-namespace:EduHorsLigne.Models"
             xmlns:loc="clr-namespace:EduHorsLigne.Helpers"
             xmlns:c="clr-namespace:EduHorsLigne.Views.Controls"
             xmlns:v="clr-namespace:EduHorsLigne.Views"
             x:Class="EduHorsLigne.Views.SubjectPage"
             x:DataType="vm:SubjectViewModel"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <c:AppBar Title="{Binding [subject_bar], Source={x:Static loc:Loc.Instance}}" ShowBack="True" />
        <Grid Grid.Row="1">

            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="Single" SelectedItem="{Binding SelectedLecon}" Margin="16,0">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,4,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Matiere.Nom}" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="✔" FontSize="18" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkColor}, Dark={StaticResource PrimaryOnDarkColor}}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Subtitle}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Text="🔍" Command="{Binding SearchCommand}" Padding="0" WidthRequest="48"
                                    SemanticProperties.Description="{Binding [tab_search], Source={x:Static loc:Loc.Instance}}" />
                        </Grid>
                        <c:ChipBar Mode="Chips" Items="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}" />
                        <Border BackgroundColor="{StaticResource ToneInfoBg}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <c:IconCircle Glyph="☁" Tone="Primary" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding [download_all_subject], Source={x:Static loc:Loc.Instance}}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource ToneInfoFg}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding DownloadSize}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource ToneInfoFg}" />
                                        <Label Text="{Binding [free_space], Source={x:Static loc:Loc.Instance}}" FontSize="12" TextColor="{StaticResource ToneInfoFg}" />
                                        <Label Text="{Binding FreeSpace}" FontSize="12" TextColor="{StaticResource ToneInfoFg}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{Binding [all_button], Source={x:Static loc:Loc.Instance}}" Command="{Binding DownloadAllCommand}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Grid>
                            <Border StrokeThickness="0" Padding="0" HeightRequest="150">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Image Source="photo_notebook.jpg" Aspect="AspectFill" SemanticProperties.Description="{Binding [official_program], Source={x:Static loc:Loc.Instance}}" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="End" Padding="14" Spacing="4" BackgroundColor="#66000000">
                                <c:Badge Text="{Binding [official_program_up], Source={x:Static loc:Loc.Instance}}" Tone="Accent" />
                                <Label Text="{Binding [official_program_text], Source={x:Static loc:Loc.Instance}}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenExercisesCommand}" /></Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="m:LeconGroup">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,14,0,4">
                            <Label Text="●" FontSize="10" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkColor}, Dark={StaticResource PrimaryOnDarkColor}}" />
                            <Label Grid.Column="1" Text="{Binding Titre}" FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <c:Badge Grid.Column="2" Text="{Binding Resume}" Tone="Ok" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Lecon"><c:LessonRow /></DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <c:EmptyState Icon="📭" Title="{Binding [state_empty_title], Source={x:Static loc:Loc.Instance}}" Message="{Binding [filter_empty], Source={x:Static loc:Loc.Instance}}" />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <Border Style="{StaticResource SoftCard}" Padding="14" Margin="0,16,0,24">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="⚡" FontSize="18" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding [catalogue_offline_note], Source={x:Static loc:Loc.Instance}}" FontSize="14" />
                        </Grid>
                    </Border>
                </CollectionView.Footer>
            </CollectionView>
            <c:StateOverlay State="{Binding State}" />
        </Grid>
    </Grid>
</ContentPage>
