<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:EduHorsLigne.Helpers" xmlns:c="clr-namespace:EduHorsLigne.Views.Controls" xmlns:m="clr-namespace:EduHorsLigne.Models"
             x:Class="EduHorsLigne.Views.Controls.OfflineBanner">
    <Border BackgroundColor="{StaticResource ToneWarnBg}" StrokeThickness="0" Padding="12,8">
        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
        <Label Text="{Binding [offline_banner], Source={x:Static loc:Loc.Instance}}" TextColor="{StaticResource ToneWarnFg}" FontSize="14" />
    </Border>
</ContentView>
