<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:EduHorsLigne.Helpers" xmlns:c="clr-namespace:EduHorsLigne.Views.Controls" xmlns:m="clr-namespace:EduHorsLigne.Models"
             x:Class="EduHorsLigne.Views.Controls.StateOverlay">
    <Grid x:Name="Root" IsVisible="False"
          BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">
        <VerticalStackLayout x:Name="LoadingView" IsVisible="False" Spacing="12" Padding="24" VerticalOptions="Center">
            <ActivityIndicator x:Name="Spinner" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" />
            <Label Text="{Binding [state_loading_text], Source={x:Static loc:Loc.Instance}}" HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}" />
            <Border Style="{StaticResource SoftCard}" HeightRequest="16" Padding="0"><Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape></Border>
            <Border Style="{StaticResource SoftCard}" HeightRequest="16" Padding="0" WidthRequest="220" HorizontalOptions="Start"><Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape></Border>
            <Border Style="{StaticResource SoftCard}" HeightRequest="16" Padding="0"><Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape></Border>
        </VerticalStackLayout>
        <c:EmptyState x:Name="EmptyView" IsVisible="False" Icon="📭"
                      Title="{Binding [state_empty_title], Source={x:Static loc:Loc.Instance}}" Message="{Binding [state_empty_text], Source={x:Static loc:Loc.Instance}}" />
        <c:EmptyState x:Name="ErrorView" IsVisible="False" Icon="⚠"
                      Title="{Binding [state_error_title], Source={x:Static loc:Loc.Instance}}" Message="{Binding [state_error_text], Source={x:Static loc:Loc.Instance}}"
                      ButtonText="{Binding [retry], Source={x:Static loc:Loc.Instance}}" />
    </Grid>
</ContentView>
