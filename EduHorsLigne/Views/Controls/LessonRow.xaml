<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:EduHorsLigne.Helpers" xmlns:c="clr-namespace:EduHorsLigne.Views.Controls" xmlns:m="clr-namespace:EduHorsLigne.Models"
             x:Class="EduHorsLigne.Views.Controls.LessonRow" x:DataType="m:Lecon">
    <Border Style="{StaticResource Card}" Padding="12">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <c:IconCircle Glyph="{Binding IconeGlyph}" Tone="{Binding IconeTon}" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding Titre}" FontAttributes="Bold" FontSize="15" />
                <Label Text="{Binding Meta}" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>
            <c:Badge Grid.Column="2" Kind="{Binding Statut}" IsVisible="{Binding ShowBadge}" VerticalOptions="Start" />
            <Label Grid.Column="2" Text="▶" FontSize="20" IsVisible="{Binding ShowPlay}" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            <Label Grid.Column="2" Text="⬇" FontSize="20" IsVisible="{Binding ShowDownload}" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Progress="{Binding Avancement}" IsVisible="{Binding ShowProgress}" />
        </Grid>
    </Border>
</ContentView>
