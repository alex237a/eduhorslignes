<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EduHorsLigne.ViewModels"
             xmlns:m="clr-namespace:EduHorsLigne.Models"
             xmlns:loc="clr-namespace:EduHorsLigne.Helpers"
             xmlns:c="clr-namespace:EduHorsLigne.Views.Controls"
             xmlns:v="clr-namespace:EduHorsLigne.Views"
             x:Class="EduHorsLigne.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <c:CenteredContent>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">
                <Grid ColumnDefinitions="Auto,*">
                    <Grid>
                        <Border BackgroundColor="{StaticResource PrimaryColor}" StrokeThickness="0" WidthRequest="60" HeightRequest="60" Padding="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Label Text="EH" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <c:IconCircle Glyph="✓" Tone="Primary" Diameter="20" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-4,-4" />
                    </Grid>
                    <c:Badge Grid.Column="1" Text="{Binding [chip_ready_offline], Source={x:Static loc:Loc.Instance}}" Tone="Neutral" Icon="☁" HorizontalOptions="End" VerticalOptions="Start" />
                </Grid>
                <Label Text="{Binding [login_title], Source={x:Static loc:Loc.Instance}}" FontSize="30" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding [login_subtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource MutedLabel}" FontSize="15" />

                <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ToneErrBg}" StrokeThickness="0" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <c:IconCircle Glyph="!" Tone="Err" Diameter="28" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding ErrorMessage}" FontAttributes="Bold" TextColor="{StaticResource ToneErrFg}" />
                            <Label Text="{Binding AttemptsText}" FontSize="13" TextColor="{StaticResource ToneErrFg}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <c:FormField Title="{Binding [field_identifier_up], Source={x:Static loc:Loc.Instance}}" UpperTitle="True" Placeholder="{Binding [ph_identifier], Source={x:Static loc:Loc.Instance}}"
                             LeadingIcon="👤" Text="{Binding Identifiant}" InputKeyboard="Email"
                             ErrorText="{Binding IdentifierError}" TagText="{Binding IdentifierTag}" />
                <c:FormField Title="{Binding [field_password_up], Source={x:Static loc:Loc.Instance}}" UpperTitle="True" Placeholder="{Binding [ph_password], Source={x:Static loc:Loc.Instance}}"
                             LeadingIcon="🔒" Text="{Binding Password}" IsPassword="True" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding RememberMe}" SemanticProperties.Description="{Binding [remember_me], Source={x:Static loc:Loc.Instance}}" />
                    <Label Grid.Column="1" Text="{Binding [remember_me], Source={x:Static loc:Loc.Instance}}" FontSize="14" VerticalOptions="Center" />
                    <Button Grid.Column="2" Style="{StaticResource TextButton}" Text="{Binding [forgot_link], Source={x:Static loc:Loc.Instance}}" FontSize="14" Command="{Binding GoForgotCommand}" />
                </Grid>
                <Grid>
                    <Button Text="{Binding ButtonLabel}" Command="{Binding LoginCommand}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="22" WidthRequest="22"
                                       Color="White" HorizontalOptions="Start" Margin="40,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <BoxView HeightRequest="1" Color="{StaticResource OutlineLight}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding [or], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CaptionLabel}" FontAttributes="Bold" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource OutlineLight}" VerticalOptions="Center" />
                </Grid>
                <Button Style="{StaticResource SoftButton}" Text="{Binding [guest_button], Source={x:Static loc:Loc.Instance}}" Command="{Binding GuestCommand}" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="{Binding [no_account], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                    <Button Style="{StaticResource TextButton}" Text="{Binding [register_link], Source={x:Static loc:Loc.Instance}}" Command="{Binding GoRegisterCommand}" />
                </HorizontalStackLayout>

                <Border IsVisible="{Binding ShowInfo}" Style="{StaticResource SoftCard}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <c:IconCircle Glyph="i" Tone="Primary" Diameter="22" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding [login_info], Source={x:Static loc:Loc.Instance}}" FontSize="14" />
                    </Grid>
                </Border>
                <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ToneOkBg}" StrokeThickness="0" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <c:IconCircle Glyph="🛡" Tone="Ok" Diameter="28" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding [security_title], Source={x:Static loc:Loc.Instance}}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource ToneOkFg}" />
                            <Label Text="{Binding [security_text], Source={x:Static loc:Loc.Instance}}" FontSize="13" TextColor="{StaticResource ToneOkFg}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Label Text="{Binding [login_footer], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </c:CenteredContent>
    </ScrollView>
</ContentPage>
