<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Charte graphique ÉduHors-Ligne (cahier des charges §16.4) -->
    <Color x:Key="PrimaryColor">#1F6F5C</Color>
    <Color x:Key="PrimaryDarkColor">#005645</Color>
    <Color x:Key="PrimaryOnDarkColor">#8AD5BE</Color>
    <Color x:Key="OnPrimaryDarkColor">#002019</Color>
    <Color x:Key="AccentColor">#F2A900</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="ErrorOnDarkColor">#FFB4AB</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>

    <Color x:Key="BgLight">#FAFAF7</Color>
    <Color x:Key="BgDark">#121212</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1F1E</Color>
    <Color x:Key="SurfaceAltLight">#EEEEEC</Color>
    <Color x:Key="SurfaceAltDark">#2A2B2A</Color>
    <Color x:Key="TextLight">#1A1C1B</Color>
    <Color x:Key="TextDark">#ECEEE9</Color>
    <Color x:Key="MutedLight">#3F4945</Color>
    <Color x:Key="MutedDark">#B5BEB9</Color>
    <Color x:Key="OutlineLight">#BEC9C4</Color>
    <Color x:Key="OutlineDark">#4A4F4D</Color>
    <Color x:Key="DisabledBgLight">#E2E3E0</Color>
    <Color x:Key="DisabledBgDark">#3A3C3B</Color>
    <Color x:Key="DisabledTextLight">#6F7975</Color>
    <Color x:Key="DisabledTextDark">#8B9490</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <!-- Pastilles : couleurs fixes, contraste >= 4,5:1 dans les deux thèmes -->
    <Color x:Key="ToneOkBg">#C8F2C2</Color>
    <Color x:Key="ToneOkFg">#00380C</Color>
    <Color x:Key="ToneWarnBg">#FFDEAD</Color>
    <Color x:Key="ToneWarnFg">#4A3000</Color>
    <Color x:Key="ToneErrBg">#FFDAD6</Color>
    <Color x:Key="ToneErrFg">#7A0A06</Color>
    <Color x:Key="ToneInfoBg">#BDEBDC</Color>
    <Color x:Key="ToneInfoFg">#00251C</Color>
    <Color x:Key="ToneNeutralBg">#E2E3E0</Color>
    <Color x:Key="ToneNeutralFg">#1A1C1B</Color>
    <Color x:Key="TonePrimaryBg">#005645</Color>
    <Color x:Key="TonePrimaryFg">#FFFFFF</Color>
    <Color x:Key="ToneAccentBg">#FEB316</Color>
    <Color x:Key="ToneAccentFg">#281900</Color>
    <Color x:Key="ErrorSoftLight">#FFF1EF</Color>
</ResourceDictionary>
